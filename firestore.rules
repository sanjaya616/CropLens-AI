rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if current user is owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function for admin check
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['sanjayalasnan327@gmail.com', 'admin@croplens.lk']
      );
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.data.role != 'admin';
      allow delete: if isAdmin();

      // Nested assessments under user
      match /assessments/{assessmentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();

        // Assessment images metadata
        match /images/{imageId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create, update, delete: if isOwner(userId) || isAdmin();
        }
      }
    }

    // Condition knowledge library (public read, admin write)
    match /conditions/{conditionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User feedback
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
