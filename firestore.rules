rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if current user is owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function for admin check (enforces custom claim token.admin == true or presence in admins collection)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.data.role != 'admin';
      allow delete: if isAdmin();

      // Nested assessments under user (Created and updated authoritatively via backend Admin SDK)
      match /assessments/{assessmentId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if false;

        // Assessment images metadata
        match /images/{imageId} {
          allow read, delete: if isOwner(userId) || isAdmin();
          allow create, update: if false;
        }
      }
    }

    // Condition knowledge library: Public read strictly for APPROVED conditions; Admin read/write all
    match /conditions/{conditionId} {
      allow read: if resource.data.reviewStatus == 'approved' || isAdmin();
      allow write: if isAdmin();
    }

    // User feedback
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
