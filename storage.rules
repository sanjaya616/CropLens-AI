rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User private assessment leaf photos
    // Writes are strictly performed through server-side Sharp EXIF-stripping pipeline via Firebase Admin SDK
    match /users/{userId}/assessments/{assessmentId}/{fileName} {
      allow read, delete: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // Public condition reference images (admin only write)
    match /conditions/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }
  }
}
